{
  "name": "dhx-gateway",
  "description": "DHX Gateway — DeepSeek Harness 多用户网关:邀请码账号、签名会话、每用户独立 dsh web 上游与流式代理。DHX (DeepSeek Harness eXchange) multi-user serving gateway for DeepSeek Harness.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "lint": "oxlint src tests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-app-boot": "link:../deepseek-harness/packages/boot/app-boot",
    "@deepseek-ai/dsh-atomic-write": "link:../deepseek-harness/packages/util/atomic-write",
    "@deepseek-ai/dsh-home-paths": "link:../deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-host-webserver": "link:../deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-invariants": "link:../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "license": "MIT"
}
